local HitmarkerConfig = {
	Enabled = true,
	Scale = 2.0,
	NormalSize = 16,
	HeadshotSize = 26,
	NormalColor = Color3.fromRGB(255, 255, 255),
	HeadshotColor = Color3.fromRGB(255, 60, 60),
	Duration = 0.28,
}

local activeHitmarkers = {}
local hitmarkerConnection = nil

local function createHitmarker(worldPosition, isHeadshot)
	if not HitmarkerConfig.Enabled then return end
	
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	
	local hud = playerGui:FindFirstChild("HUD")
	if not hud then
		hud = Instance.new("ScreenGui")
		hud.Name = "HUD"
		hud.ResetOnSpawn = false
		hud.Parent = playerGui
	end
	
	local camera = workspace.CurrentCamera
	if not camera then return end
	
	local screenPos, onScreen = camera:WorldToViewportPoint(worldPosition)
	if not onScreen or screenPos.Z <= 0 then return end
	
	local baseSize = isHeadshot and HitmarkerConfig.HeadshotSize or HitmarkerConfig.NormalSize
	local finalSize = baseSize * HitmarkerConfig.Scale
	
	local frame = Instance.new("Frame")
	frame.Name = isHeadshot and "HitmarkerHeadshot" or "Hitmarker"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Size = UDim2.fromOffset(finalSize, finalSize)
	frame.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
	frame.Visible = true
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = frame
	
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Color = isHeadshot and HitmarkerConfig.HeadshotColor or HitmarkerConfig.NormalColor
	stroke.Thickness = (isHeadshot and 2.25 or 1.5) * HitmarkerConfig.Scale
	stroke.Transparency = 0
	stroke.Parent = frame
	
	local scale = Instance.new("UIScale")
	scale.Scale = 0.1
	scale.Parent = frame
	
	frame.Parent = hud
	
	local hitmarkerData = {
		ring = frame,
		stroke = stroke,
		scale = scale,
		worldPos = worldPosition,
		bornAt = os.clock()
	}
	
	table.insert(activeHitmarkers, hitmarkerData)
	
	if not hitmarkerConnection then
		hitmarkerConnection = RunService.RenderStepped:Connect(function()
			local currentTime = os.clock()
			local camera = workspace.CurrentCamera
			
			for i = #activeHitmarkers, 1, -1 do
				local marker = activeHitmarkers[i]
				
				if not marker.ring.Parent then
					table.remove(activeHitmarkers, i)
				else
					local elapsed = currentTime - marker.bornAt
					local progress = elapsed / HitmarkerConfig.Duration
					
					local easeOut = 1 - progress
					local easeCubic = 1 - easeOut * easeOut * easeOut
					marker.scale.Scale = easeCubic * 1.9 + 0.1
					
					if elapsed >= HitmarkerConfig.Duration then
						marker.ring:Destroy()
						table.remove(activeHitmarkers, i)
					else
						if elapsed >= 0.08 then
							local fadeProgress = (elapsed - 0.08) / 0.2
							marker.stroke.Transparency = math.clamp(fadeProgress, 0, 1)
						end
						
						if camera then
							local screenPos, onScreen = camera:WorldToViewportPoint(marker.worldPos)
							if onScreen and screenPos.Z > 0 then
								marker.ring.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
								marker.ring.Visible = true
							else
								marker.ring.Visible = false
							end
						end
					end
				end
			end
			
			if #activeHitmarkers == 0 and hitmarkerConnection then
				hitmarkerConnection:Disconnect()
				hitmarkerConnection = nil
			end
		end)
	end
end

local InfiniteAmmo = {
	Enabled = true,
	AmmoPool = nil,
	OriginalConsume = nil,
	OriginalGetReserve = nil,
	OriginalFire = nil,
}

local function SetupInfiniteAmmo()
	if not InfiniteAmmo.Enabled then return end

	local success, AmmoPool = pcall(function()
		return require(ReplicatedStorage.Modules.Shared.AmmoPool)
	end)
	if not success or not AmmoPool then
		return
	end
	InfiniteAmmo.AmmoPool = AmmoPool

	if AmmoPool.ConsumeAmmo and not InfiniteAmmo.OriginalConsume then
		InfiniteAmmo.OriginalConsume = AmmoPool.ConsumeAmmo
		AmmoPool.ConsumeAmmo = function(self, ammoType, amount)
			if ammoType == "infinite" then
				return amount
			end
			return amount
		end
	end

	if AmmoPool.SetAmmo and not InfiniteAmmo.OriginalSetAmmo then
		InfiniteAmmo.OriginalSetAmmo = AmmoPool.SetAmmo
		AmmoPool.SetAmmo = function(self, ammoType, amount)
			if ammoType == "infinite" then return end
			local maxReserve = self._maxReserve[ammoType] or math.huge
			self._pools[ammoType] = maxReserve
			if self.AmmoChanged then
				self.AmmoChanged:Fire(ammoType, maxReserve, 0)
			end
		end
	end

	if GunController and GunController.Weapon then
		local weapon = GunController.Weapon
		if weapon then
			weapon.AmmoType = "infinite"
			weapon.MagAmmo = weapon.MaxMagSize or 999
		end
	end
end

local function MaintainInfiniteAmmo()
	if not InfiniteAmmo.Enabled then return end

	local AmmoPool = InfiniteAmmo.AmmoPool
	if AmmoPool and AmmoPool._pools then
		for ammoType, maxAmount in pairs(AmmoPool._maxReserve or {}) do
			if ammoType ~= "infinite" then
				AmmoPool._pools[ammoType] = maxAmount
			end
		end
	end

	if GunController and GunController.Weapon then
		local weapon = GunController.Weapon
		if weapon and weapon.MagAmmo ~= nil then
			local maxAmmo = weapon.MaxMagSize or 999
			if weapon.MagAmmo <= 0 then
				weapon.MagAmmo = maxAmmo
				if weapon.AmmoChanged then
					weapon.AmmoChanged:Fire(weapon.MagAmmo, 9999)
				end
			end
		end
	end
end

SetupInfiniteAmmo()

local WeaponMods = {
	FullAuto = true,
	NoRecoil = false,
	CustomFireRate = false,
	FireRateMultiplier = 1.0,
}

local function ApplyWeaponMods()
	if not WeaponsRegistry then return end

	for weaponName, weaponData in pairs(WeaponsRegistry) do
		if type(weaponData) == "table" and weaponData.FireRate then
			if WeaponMods.FullAuto then
				weaponData.FireMode = "Auto"
				if weaponData.FireModes then
					weaponData.FireModes = {"Auto", "Semi"}
				end
			end

			if WeaponMods.NoRecoil then
				weaponData.RecoilMult = 0
				weaponData.RecoilPushMult = 0
				weaponData.RecoilPitchMult = 0
				weaponData.RecoilTilt = 0
				weaponData.CameraRecoilMult = 0
				weaponData.CameraRecoilAimMult = 0
				weaponData.RecoilSpeedMult = 0
				weaponData.FireDriftScale = 0
				
				if weaponData.Bloom then
					weaponData.Bloom.Base = 0
					weaponData.Bloom.PerShot = 0
					weaponData.Bloom.Max = 0
				end
			end

			if WeaponMods.CustomFireRate then
				local originalRate = weaponData.FireRate
				weaponData.FireRate = originalRate / WeaponMods.FireRateMultiplier
			end
		end
	end
	
end

local function ApplyGunControllerMods()
	if not GunController then return end

	if WeaponMods.NoRecoil and GunController.ApplyRecoil then
		GunController.ApplyRecoil = function() end
	end

	if GunController.Weapon then
		local weapon = GunController.Weapon
		if weapon then
			if WeaponMods.FullAuto then
				weapon.FireMode = "auto"
			end

			if WeaponMods.NoRecoil and weapon.RecoilSpring then
				weapon.RecoilSpring.s = 0
				weapon.RecoilSpring.d = 0
			end

			if WeaponMods.CustomFireRate then
				local currentName = weapon.Name
				local weaponData = WeaponsRegistry[currentName]
				if weaponData and weaponData.FireRate then
					weapon.FireRate = weaponData.FireRate
				end
			end
		end
	end
end

ApplyWeaponMods()

