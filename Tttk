local function createBeamTracer(startPos, endPos)
	local beam = Instance.new("Beam")
	for k, v in pairs(beamTemplate) do
		beam[k] = v
	end
	beam.Color = ColorSequence.new(tracerColor)
	beam.Transparency = NumberSequence.new(tracerTransparency)
	beam.Width0 = 3.0
	beam.Width1 = 3.0
	
	local att0 = Instance.new("Attachment")
	att0.CFrame = CFrame.new(startPos)
	att0.Parent = workspace.Terrain
	
	local att1 = Instance.new("Attachment")
	att1.CFrame = CFrame.new(endPos)
	att1.Parent = workspace.Terrain
	
	beam.Attachment0 = att0
	beam.Attachment1 = att1
	beam.Parent = beamFolder
	
	task.delay(tracerLifetime, function()
		local fadeElapsed = 0
		local fadeConn
		fadeConn = RunService.Heartbeat:Connect(function(dt)
			fadeElapsed = fadeElapsed + dt
			local alpha = math.clamp(fadeElapsed / 0.2, 0, 1)
			beam.Transparency = NumberSequence.new(tracerTransparency + (1 - tracerTransparency) * alpha)
			if fadeElapsed >= 0.2 then
				fadeConn:Disconnect()
				att0:Destroy()
				att1:Destroy()
				beam:Destroy()
			end
		end)
	end)
end

local function createLayeredGlow(part, mainColor, glowColor, transparency)
	local isHead = part.Name == "Head"
	
	local baseColor = Color3.new(glowColor.R * 5, glowColor.G * 5, glowColor.B * 5)
	
	local glowAdornment
	if isHead then
		glowAdornment = Instance.new("CylinderHandleAdornment")
		glowAdornment.Height = part.Size.Y + 0.03
		glowAdornment.Radius = (part.Size.X * 0.5) + 0.03
		glowAdornment.CFrame = CFrame.new(Vector3.new(0, 0, 0), Vector3.new(0, 1, 0))
	else
		glowAdornment = Instance.new("BoxHandleAdornment")
		glowAdornment.Size = part.Size + Vector3.new(0.03, 0.03, 0.03)
	end
	
	glowAdornment.Name = "Chams"
	glowAdornment.AlwaysOnTop = true
	glowAdornment.ZIndex = isHead and 10 or 9
	glowAdornment.Adornee = part
	glowAdornment.Color3 = baseColor
	glowAdornment.Transparency = math.clamp(-1 + transparency, -1, 1)
	glowAdornment.Shading = Enum.AdornShading.XRayShaded
	glowAdornment.Parent = part
	
	local mainAdornment
	if isHead then
		mainAdornment = Instance.new("CylinderHandleAdornment")
		mainAdornment.Height = part.Size.Y + 0.02
		mainAdornment.Radius = (part.Size.X * 0.5) + 0.02
		mainAdornment.CFrame = CFrame.new(Vector3.new(0, 0, 0), Vector3.new(0, 1, 0))
	else
		mainAdornment = Instance.new("BoxHandleAdornment")
		mainAdornment.Size = part.Size + Vector3.new(0.02, 0.02, 0.02)
	end
	
	mainAdornment.Name = "Chams"
	mainAdornment.AlwaysOnTop = true
	mainAdornment.ZIndex = 10
	mainAdornment.Adornee = part
	mainAdornment.Color3 = mainColor
	mainAdornment.Transparency = math.clamp(0.3 + transparency, 0, 1)
	mainAdornment.Parent = part
	
	return glowAdornment, mainAdornment
end

local function createHitModel(targetChar, hitPos, targetUserId)
	if not targetChar then return end
	
	local clonedModel = targetChar:Clone()
	clonedModel.Name = "HitClone"
	clonedModel.Parent = hitModelFolder
	
	if not hitModelsByPlayer[targetUserId] then
		hitModelsByPlayer[targetUserId] = {}
	end
	
	local mainColor = Color3.new(0, 0, 0)
	local glowColor = Color3.new(1, 1, 1)
	
	for _, part in ipairs(clonedModel:GetDescendants()) do
		if part:IsA("BasePart") then
			createLayeredGlow(part, mainColor, glowColor, 0.3)
		end
		
		if part:IsA("Script") or part:IsA("LocalScript") or part:IsA("ModuleScript") then
			part:Destroy()
		end
		
		if part:IsA("Humanoid") then
			part:Destroy()
		end
	end
	
	if clonedModel.PrimaryPart then
		clonedModel:SetPrimaryPartCFrame(CFrame.new(hitPos))
	elseif clonedModel:FindFirstChild("HumanoidRootPart") then
		clonedModel.HumanoidRootPart.CFrame = CFrame.new(hitPos)
	end
	
	table.insert(hitModelsByPlayer[targetUserId], 1, clonedModel)
	
	for i, oldModel in ipairs(hitModelsByPlayer[targetUserId]) do
		local baseTransparency = 0.3
		local transparencyAdd = (i - 1) * 0.5
		local finalTransparency = baseTransparency + transparencyAdd
		
		for _, part in ipairs(oldModel:GetDescendants()) do
			if part:IsA("BasePart") then
				for _, adornment in ipairs(part:GetChildren()) do
					if adornment.Name == "Chams" then
						if adornment:IsA("BoxHandleAdornment") or adornment:IsA("CylinderHandleAdornment") then
							if adornment.ZIndex < 10 then
								adornment.Transparency = math.clamp(-1 + finalTransparency, -1, 1)
							else
								adornment.Transparency = math.clamp(finalTransparency, 0, 1)
							end
						end
					end
				end
			end
		end
	end
	
	task.delay(5, function()
		clonedModel:Destroy()
		if hitModelsByPlayer[targetUserId] then
			for i, model in ipairs(hitModelsByPlayer[targetUserId]) do
				if model == clonedModel then
					table.remove(hitModelsByPlayer[targetUserId], i)
					break
				end
			end
		end
	end)
end

local function sendNotification(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 2
		})
	end)
end

local function getWeaponFireRate(weaponName)
	if WeaponsRegistry and WeaponsRegistry[weaponName] then
		local weaponData = WeaponsRegistry[weaponName]
		if weaponData.FireRate and type(weaponData.FireRate) == "number" then
			return weaponData.FireRate
		end
	end
	return 0.08
end

local function getRandomBodyPart()
	if RANDOM_BODYPART_ENABLED then
		return BODY_PARTS[math.random(1, #BODY_PARTS)]
	end
	return nil
end

local function getCurrentWeapon()
	local attrWeapon = player:GetAttribute("CurrentWeapon")
	if attrWeapon and typeof(attrWeapon) == "string" then
		return attrWeapon
	end
	
	local char = player.Character
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") then
				return child.Name
			end
		end
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Model") then
				local hasBarrel = child:FindFirstChild("Barrel")
				local hasMagazine = child:FindFirstChild("Magazine")
				local hasHandle = child:FindFirstChild("Handle")
				
				if (hasBarrel and hasMagazine) or (hasBarrel and hasHandle) then
					return child.Name
				end
			end
		end
	end
	
	local cam = workspace.CurrentCamera
	if cam then
		for _, child in ipairs(cam:GetChildren()) do
			if child:IsA("Model") then
				local hasBarrel = child:FindFirstChild("Barrel")
				local hasMagazine = child:FindFirstChild("Magazine")
				local hasHandle = child:FindFirstChild("Handle")
				
				if (hasBarrel and hasMagazine) or (hasBarrel and hasHandle) then
					return child.Name
				end
			end
		end
	end
	
	return nil
end

local function isDead(part)
	local check = part
	while check and check ~= workspace do
		if check:GetAttribute("Dead") == true then
			return true
		end
		check = check.Parent
	end
	return false
end

local function hasWallBetween(fromPos, toPos)
	local direction = (toPos - fromPos)
	local distance = direction.Magnitude
	
	if distance < 0.1 then return false end
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	
	local filterList = {}
	table.insert(filterList, player.Character)
	table.insert(filterList, workspace.CurrentCamera)
	
	local mercPlayers = workspace:FindFirstChild("MercPlayers")
	if mercPlayers then
		table.insert(filterList, mercPlayers)
	end
	
	local activeMap = workspace:FindFirstChild("ActiveMap") or workspace:FindFirstChild("Map")
	if activeMap then
		local touchables = activeMap:FindFirstChild("Touchables")
		if touchables then
			table.insert(filterList, touchables)
		end
		local ignore = activeMap:FindFirstChild("Ignore")
		if ignore then
			table.insert(filterList, ignore)
		end
	end
	
	local ignoreFolder = workspace:FindFirstChild("Ignore")
	if ignoreFolder then
		table.insert(filterList, ignoreFolder)
	end
	
	raycastParams.FilterDescendantsInstances = filterList
	
	local rayResult = workspace:Raycast(fromPos, direction.Unit * (distance - 0.1), raycastParams)
	
	return rayResult ~= nil
end

local function getClosestTarget()
	local char = player.Character
	if not char then return nil, nil, nil, nil, nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil, nil, nil, nil, nil end

	local myUserId = player.UserId
	local closestDist = math.huge
	local closestUserId = nil
	local closestHitPos = nil
	local closestBodyPart = nil
	local closestChar = nil

	local tagged = CollectionService:GetTagged("MercBodyPart")
	for _, part in ipairs(tagged) do
		if part:IsA("BasePart") and part.Parent then
			if isDead(part) then
				continue
			end

			local ownerId = part:GetAttribute("OwnerUserId")
			local bodyPartName = part:GetAttribute("MercBodyPart")
			local targetChar = part:FindFirstAncestorOfClass("Model")

			if targetChar and targetChar.Name == "HitClone" then
				continue
			end
			
			if targetChar and targetChar.Parent == hitModelFolder then
				continue
			end

			if not ownerId or not bodyPartName then
				if targetChar then
					ownerId = ownerId or targetChar:GetAttribute("OwnerUserId")
					bodyPartName = bodyPartName or part.Name
				end
			end

			if ownerId and typeof(ownerId) == "number" and ownerId ~= myUserId and bodyPartName then
				local dist = (root.Position - part.Position).Magnitude
				if dist < closestDist then
					if not hasWallBetween(root.Position, part.Position) then
						closestDist = dist
						closestUserId = ownerId
						closestHitPos = part.Position
						closestBodyPart = bodyPartName
						closestChar = targetChar
					end
				end
			end
		end
	end

	if closestUserId and closestHitPos and closestBodyPart then
		local direction = (closestHitPos - root.Position).Unit
		return closestUserId, closestHitPos, direction, closestBodyPart, closestChar
	end
	return nil, nil, nil, nil, nil
end

local shotSequence = 0

BulletController.HitConfirmed:Connect(function()
	hitCount = hitCount + 1
end)

BulletController.KillConfirmed:Connect(function()
	killCount = killCount + 1
end)

RunService.Heartbeat:Connect(function()
	MaintainInfiniteAmmo()
	ApplyGunControllerMods()

	local weapon = getCurrentWeapon()
	if not weapon then return end

	if weapon ~= currentWeaponName then
		currentWeaponName = weapon
		currentFireRate = getWeaponFireRate(weapon)
		local rpm = math.floor(60 / currentFireRate)
		sendNotification("weapon", string.format("%s | %d RPM", weapon, rpm))

		if InfiniteAmmo.Enabled then
			SetupInfiniteAmmo()
		end
		
		ApplyGunControllerMods()
	end

	local currentTime = tick()
	if currentTime - lastAttackTime < currentFireRate then
		return
	end

	local targetUserId, hitPos, direction, bodyPart, targetChar = getClosestTarget()
	if not (targetUserId and hitPos and direction and bodyPart) then return end

	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local randomBodyPart = getRandomBodyPart()
	if randomBodyPart then
		bodyPart = randomBodyPart
	end

	local origin = root.Position
	
	if currentTime - lastAttackTime < currentFireRate then
		return
	end
	
	shotSequence = shotSequence + 1
	attackCount = attackCount + 1
	lastAttackTime = currentTime
	
	if GunController and GunController.FireWeapon then
		GunController:FireWeapon()
	end
	
	WeaponFired:FireServer(weapon, origin, direction, targetUserId, shotSequence)
	MercHitClaim:FireServer(weapon, targetUserId, bodyPart, origin, direction, hitPos, shotSequence)
	
	local isHeadshot = (bodyPart == "Head")
	createHitmarker(hitPos, isHeadshot)
	
	createBeamTracer(origin, hitPos)
	createHitModel(targetChar, hitPos, targetUserId)
end)
